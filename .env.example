# Pick a provider: openai (default when OPENAI_API_KEY is set) or anthropic.
PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# gpt-4.1-mini (default for openai) | claude-opus-5 (default for anthropic) | any model in llm.mjs PRICES
MODEL=gpt-4.1-mini
EFFORT=low
GUARD_SECRET=change-me-to-a-long-random-string
DAILY_BUDGET_USD=1.50
DAILY_AI_CALLS=400
MESSAGES_PER_SESSION=14
SESSIONS_PER_IP_PER_HOUR=6
POW_BITS=17
AI_ENABLED=true
